{
  "name": "@century/bench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Headless benchmark harness for the Fabric of Nations simulation core.",
  "main": "./dist/bench.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/bench.js",
    "campaign": "node ./dist/m6Campaign.js",
    "world": "node ./dist/p1WorldBench.js",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@century/data": "workspace:*",
    "@century/sim": "workspace:*",
    "@century/sim-worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.2"
  }
}
