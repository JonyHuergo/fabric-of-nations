 "meta": {
  "decision": "D-143 §4",
  "description": "Authored 1900 deposits (D-121): coal, oil, gas, nitrate and uranium, which USGS MRDS barely covers, and the giant metal ore bodies whose size or 1900 knowledge state MRDS does not give. Each entry is one (province, resource) deposit with a size class, a quality, whether it was known on 1 January 1900, and, for a hidden deposit, the prospecting technology that makes it findable. Sizes are classes, not reserve estimates; the class stocks are in scripts/p5/build-p5-world.mjs (provisional). Offshore fields are assigned to the nearest coastal province.",
  "classes": "S small, M medium, L large, G giant, SG supergiant",
  "prospectingTechnologies": {
   "geological-surveying": "systematic geological mapping and core drilling (era 1; national surveys of the 19th century)",
   "geophysical-prospecting": "seismic refraction and reflection, gravity and magnetic surveys (era 2; from the 1920s)",
   "airborne-geophysics": "airborne magnetometry and radiometry, marine seismic (era 3; from the 1950s)"
  },
  "status": "provisional",
  "confidence": "medium for the named basins and fields, low for size classes"
 },
