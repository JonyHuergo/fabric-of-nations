{
  "name": "@century/data",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Validated JSON static definitions and loaders for Century.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@century/sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.2"
  }
}
