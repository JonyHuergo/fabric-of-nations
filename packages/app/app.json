{
  "expo": {
    "name": "Fabric of Nations",
    "slug": "fabric-of-nations",
    "version": "0.3.0",
    "description": "A historically grounded grand-strategy simulation of the world from 1900 to 2000.",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1419",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.century.game",
      "icon": "./assets/icon.png",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.century.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1419"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Fabric of Nations",
      "shortName": "Fabric of Nations",
      "lang": "en",
      "description": "A historically grounded grand-strategy simulation of the world from 1900 to 2000.",
      "themeColor": "#0d1419",
      "backgroundColor": "#0d1419",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    }
  }
}
