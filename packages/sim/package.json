{
  "name": "@century/sim",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pure deterministic simulation core for Century. No platform, DOM, or UI dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
