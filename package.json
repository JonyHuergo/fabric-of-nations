{
  "name": "century",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:libs": "pnpm -F @century/sim build && pnpm -F @century/data build && pnpm -F @century/sim-worker build",
    "lint": "node scripts/check-boundaries.mjs",
    "map:build": "node --max-old-space-size=8192 scripts/map/build-render-bundle.mjs",
    "map:check": "node --max-old-space-size=8192 scripts/map/build-render-bundle.mjs --check",
    "map:atlas": "node scripts/map/build-atlas.mjs",
    "map:atlas:check": "node scripts/map/build-atlas.mjs --check",
    "map:verify": "node scripts/map/verify-map.mjs",
    "map:verify:file": "node scripts/map/verify-file-origin.mjs",
    "map:audit:sheets": "node scripts/map/audit-sheets.mjs",
    "map:measure": "node scripts/map/measure-map.mjs",
    "flags:build": "node scripts/m11/build-flags.mjs",
    "flags:check": "node scripts/m11/build-flags.mjs --check",
    "flags:audit": "node scripts/m11/build-flags.mjs --audit",
    "flags:update": "node scripts/m11/build-flags.mjs --update",
    "check:worker": "pnpm run build:libs && pnpm -F @century/sim-worker scenario:build:check && pnpm -F @century/app build:worker:check",
    "check:sim-deps": "node scripts/m11e/check-sim-dependencies.mjs",
    "audit:branding": "node scripts/m13/branding-audit.mjs",
    "audit:branding:dist": "node scripts/m13/branding-audit.mjs --dist",
    "audit:monetary": "node scripts/m14/monetary-terminology-audit.mjs",
    "typecheck": "pnpm run build:libs && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "bench": "pnpm build && pnpm -F @century/bench start",
    "bench:campaign": "pnpm build && pnpm -F @century/bench campaign",
    "app:export": "pnpm -F @century/app export:web && pnpm -F @century/app export:ios && pnpm -F @century/app export:android",
    "ci": "pnpm lint && pnpm audit:branding && pnpm audit:monetary && pnpm run check:worker && pnpm run check:sim-deps && pnpm map:atlas:check && pnpm typecheck && pnpm test && pnpm bench && pnpm run app:export"
  },
  "devDependencies": {
    "earcut": "3.0.2",
    "jimp-compact": "0.16.1",
    "polygon-clipping": "0.15.7",
    "typescript": "5.9.3"
  }
}
