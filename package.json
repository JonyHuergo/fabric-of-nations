{
  "name": "century",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "bench": "pnpm build && pnpm -F @century/bench start",
    "bench:campaign": "pnpm build && pnpm -F @century/bench campaign",
    "app:export": "pnpm -F @century/app export:web && pnpm -F @century/app export:ios && pnpm -F @century/app export:android",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm bench && pnpm run app:export"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
